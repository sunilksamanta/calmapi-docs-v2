# Generated by scripts/generate-docs-assets.mjs (npm run dev / npm run build). Files in public/
# are served at their path, so the raw markdown copies of the pages are written there:
# /<slug>.md at the root and /blocks/<name>.md. Committed markdown files in public/ need a
# "!" exception here (like copilot-instructions.md).
src/generated/
/public/llms.txt
/public/llms-full.txt
/public/*.md
!/public/copilot-instructions.md
/public/blocks/
